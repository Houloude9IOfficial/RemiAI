# RemiAPI Worker — optional env (no secrets required for the zero-cost set)
# Copy to .dev.vars for `wrangler dev` or set via dashboard / `wrangler secret put`.

# Optional API keys (only if you enable those card types later):
# NEWS_API_KEY=
# STOCKS_API_KEY=

# Optional tuning:
# UPSTREAM_TIMEOUT_MS=8000
# ALLOWED_ORIGINS=https://example.com,http://localhost:3000
# CACHE_TTL_WEATHER=600
# CACHE_TTL_TIMEZONE=300
# CACHE_TTL_CURRENCY=3600
# CACHE_TTL_MAP=86400
# CACHE_TTL_CRYPTO=60
# CACHE_TTL_NEWS=300
# CACHE_TTL_STOCK=60

# Optional server-side proxy allowlist (comma-separated origins, empty = reflect request Origin if present)
# ALLOWED_ORIGINS=
