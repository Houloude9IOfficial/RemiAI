{
  "name": "remiai",
  "description": "RemiAI is a self-hosted, privacy-first AI assistant that brings chat, file management, web search, and automation together in one extensible workspace fully under your control.",
  "version": "2.7.0",
  "author": {
    "name": "CrickDevs",
    "email": "support@crickdevs.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Houloude9IOfficial/RemiAI.git"
  },
  "bugs": {
    "url": "https://github.com/Houloude9IOfficial/RemiAI/issues"
  },
  "homepage": "https://remiai.crickdevs.com",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "npx tsx scripts/launcher.ts --dev",
    "dev:web": "next dev --webpack -H 127.0.0.1",
    "rebuild:electron": "npx electron-rebuild -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dev:electron": "npx tsc -p electron/tsconfig.json && npx electron electron-dist/main.js",
    "build": "next build && node scripts/prune-standalone.mjs",
    "build:electron": "npx tsc -p electron/tsconfig.json",
    "playwright:install": "playwright install chromium",
    "playwright:browsers": "node scripts/install-playwright-browsers.mjs",
    "start": "npx tsx scripts/launcher.ts",
    "start:web": "next start -H 127.0.0.1",
    "start:electron": "NODE_ENV=production npx electron electron-dist/main.js",
    "icons": "node scripts/generate-icons.mjs",
    "clean:dist": "rm -rf release .next",
    "dist": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && npm run playwright:browsers && electron-builder",
    "dist:mac": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && npm run playwright:browsers && electron-builder --mac",
    "dist:win": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && npm run playwright:browsers && electron-builder --win",
    "dist:linux": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && npm run playwright:browsers && electron-builder --linux",
    "lint": "eslint",
    "test": "npx tsx scripts/test-model-preferences.ts && npx tsx scripts/test-ollama-reasoning-middleware.ts && npx tsx scripts/test-chat-reconstruction.ts && npx tsx scripts/test-persist-interval.ts && npx tsx scripts/test-error-payload.ts && npx tsx scripts/test-observability.ts && npx tsx scripts/test-artifacts.ts && npx tsx scripts/test-canvas.ts && npx tsx scripts/test-research-sources.ts && npx tsx scripts/test-web-search.ts && npx tsx scripts/test-build-verification.ts && npx tsx scripts/test-build-runs.ts && npx tsx scripts/test-quality-policy.ts && npx tsx scripts/test-automation-runs.ts && npx tsx scripts/test-notifications.ts",
    "postinstall": "drizzle-kit migrate || echo '(Migration skipped - it will run on app startup)'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "watch:standalone": "npx tsx scripts/file-watcher.ts",
    "auth:reset": "npx tsx scripts/auth-reset.ts",
    "signing:secrets": "node scripts/setup-signing-secrets.mjs",
    "demo:setup": "node scripts/demo-setup.js"
  },
  "main": "electron-dist/main.js",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.56",
    "@ai-sdk/groq": "^4.0.33",
    "@ai-sdk/mcp": "^2.0.10",
    "@ai-sdk/mistral": "^4.0.35",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "^4.0.23",
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@huggingface/transformers": "^4.2.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/inquirer": "^9.0.10",
    "@uiw/react-codemirror": "^4.25.11",
    "ai": "^7.0.22",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firecrawl": "^4.30.0",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.4.2",
    "highlight.js": "^11.11.1",
    "inquirer": "^14.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.9.0",
    "markdown-to-jsx": "^9.8.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.62.1",
    "postcss": "8.5.25",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25"
    },
    "sharp": "^0.35.3",
    "fast-uri": "^3.1.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@hono/node-server": "^2.0.12",
    "tar": "^7.5.22",
    "minimatch@9.0.9": {
      "brace-expansion": "5.0.9"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
