{
  "name": "remiai",
  "description": "Local AI assistant designed to help you interact with your files, run searches, and connect to external tools (MCP servers).",
  "version": "1.3.0",
  "author": "CrickDevs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Houloude9IOfficial/RemiAI.git"
  },
  "bugs": {
    "url": "https://github.com/Houloude9IOfficial/RemiAI/issues"
  },
  "homepage": "https://remiai.crickdevs.com",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "npx tsx scripts/launcher.ts",
    "dev:web": "next dev -H 127.0.0.1",
    "dev:electron": "npx tsc -p electron/tsconfig.json && npx electron electron-dist/main.js",
    "build": "next build",
    "build:electron": "npx tsc -p electron/tsconfig.json",
    "start": "npx tsx scripts/launcher.ts",
    "start:web": "next start -H 127.0.0.1",
    "start:electron": "NODE_ENV=production npx electron electron-dist/main.js",
    "icons": "node scripts/generate-icons.mjs",
    "clean:dist": "rm -rf release .next",
    "dist": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && electron-builder",
    "dist:mac": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && electron-builder --mac",
    "dist:win": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && electron-builder --win",
    "dist:linux": "npm run clean:dist && npm run icons && npm run build && npm run build:electron && electron-builder --linux",
    "lint": "eslint",
    "postinstall": "drizzle-kit migrate || echo '(Migration skipped - it will run on app startup)'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "watch:standalone": "npx tsx scripts/file-watcher.ts"
  },
  "main": "electron-dist/main.js",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/mcp": "^2.0.10",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "^4.0.23",
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/inquirer": "^9.0.10",
    "ai": "^7.0.22",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "firecrawl": "^4.30.0",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.4.2",
    "highlight.js": "^11.11.1",
    "inquirer": "^14.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.9.0",
    "markdown-to-jsx": "^9.8.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
